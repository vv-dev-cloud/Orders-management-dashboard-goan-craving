<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Employee sign in · Goan Craving</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <main class="login-screen">
    <section class="employee-login-card">
      <a class="employee-login-brand" href="/login"><span class="brand-icon">🌿</span> Goan Craving</a>
      <h1>Employee sign in</h1>
      <p class="login-subtitle">Use the access details provided by your administrator.</p>
      <% if (error) { %><div class="login-error" role="alert"><%= error %></div><% } %>
      <form method="post" action="/login">
        <label for="employeeId">Employee ID</label>
        <input id="employeeId" name="employeeId" autocomplete="username" required placeholder="GCEMP-XXXXXXXX">
        <label for="email">Email address</label>
        <input id="email" name="email" type="email" autocomplete="email" required placeholder="you@example.com">
        <label for="password">Temporary password</label>
        <input id="password" name="password" type="password" autocomplete="current-password" required placeholder="Enter your password">
        <button class="login-submit" type="submit">Sign in to dashboard</button>
      </form>
      <p class="employee-login-foot">If you cannot sign in, contact your administrator.</p>
    </section>
  </main>
</body>
</html>